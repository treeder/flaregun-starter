{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flaregun",
  "compatibility_date": "2026-06-29",
  "main": "./src/worker.js",
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS"
  },
  "preview_urls": true,
  "vars": {
    "ENV": "prod"
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "KV"
    }
  ],
  "d1_databases": [
    {
      "binding": "D1",
      "database_name": "flaregun"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "flaregun"
    }
  ],
  "previews": {
    "vars": {
      "ENV": "preview"
    },
    "kv_namespaces": [
      {
        "binding": "KV"
      }
    ],
    "d1_databases": [
      {
        "binding": "D1",
        "database_name": "flaregun-preview"
      }
    ],
    "r2_buckets": [
      {
        "binding": "R2",
        "bucket_name": "flaregun-preview"
      }
    ]
  },
  "placement": {
    "mode": "smart"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": {
      "enabled": true
    }
  },
  "compatibility_flags": ["global_fetch_strictly_public"]
}
