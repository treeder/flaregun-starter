{
  "name": "flaregun-starter",
  "type": "module",
  "version": "2.0.0",
  "main": "index.js",
  "scripts": {
    "start": "vite dev",
    "build": "vite build",
    "run": "vite --port 8787",
    "test:run": "vitest run",
    "test": "vitest run",
    "setup": "npx -y treeder/flaregun setup",
    "deploy": "npm run build && wrangler deploy",
    "deploy:preview": "npm run build && wrangler preview",
    "format": "prettier --write ."
  },
  "author": "treeder",
  "license": "Apache-2.0",
  "description": "",
  "dependencies": {
    "api": "github:treeder/api#semver:^1",
    "console-logger": "github:treeder/console-logger#semver:^1",
    "flaregun": "github:treeder/flaregun#semver:^4",
    "migrations": "github:treeder/migrations#semver:^3",
    "nanoid": "^6.0.1",
    "once": "github:treeder/once#semver:^1",
    "passkeys": "github:treeder/passkeys#semver:^5",
    "rend": "github:treeder/rend#semver:^1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.57.1",
    "prettier": "^3.9.8",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.136.1"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "all",
    "printWidth": 120,
    "bracketSameLine": true
  }
}
